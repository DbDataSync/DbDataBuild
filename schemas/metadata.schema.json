{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dbdatabuild:schemas:metadata",
  "title": "DbDataBuild metadata documents",
  "description": "The kinds of metadata document: one per project (`dbdatabuild.project/1`), one per source table the project reads but does not build (`dbdatabuild.source/1`), and one per model (`dbdatabuild.model/1`). The same documents are printed by `validate` and `metadata` with `--format json`, and stored in the target's tracking tables (`publish-metadata`, views `metadata_current` and `metadata_columns`). Null values are omitted, never written as null. A new optional key is not a version change; a removed or retyped key is.",
  "oneOf": [
    {
      "$ref": "#/$defs/project"
    },
    {
      "$ref": "#/$defs/source"
    },
    {
      "$ref": "#/$defs/model"
    }
  ],
  "$defs": {
    "hook": {
      "description": "A hook entry as written: a reference to a group, or a named script on an event.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "use": {
              "type": "string"
            }
          },
          "required": [
            "use"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "event": {
              "type": "string"
            },
            "script": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              ]
            },
            "connections": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "effect": {
              "enum": [
                "ddl",
                "data"
              ]
            },
            "risk": {
              "enum": [
                "safe",
                "risky",
                "destructive"
              ]
            }
          },
          "required": [
            "name",
            "event",
            "script",
            "effect",
            "risk"
          ]
        }
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "dbdatabuild.project/1"
        },
        "tool_version": {
          "type": "string"
        },
        "matrix_version": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default_connections": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "connections": {
              "type": "object",
              "description": "The project's connections by name: the engine and, when set, the version the tool generates for. A connection named after an engine exists without being declared.",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "engine": {
                    "type": "string"
                  },
                  "version": {
                    "type": "integer"
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "tags": {
                    "description": "Sorted; omitted when there are none.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "properties": {
                    "description": "Key to value (a string, a number or a boolean), keys sorted; omitted when there are none.",
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  }
                },
                "required": [
                  "engine"
                ]
              }
            },
            "target_versions": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            "tracking_schema": {
              "type": "string"
            },
            "string_semantics": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "case": {
                  "type": "string"
                },
                "accent": {
                  "type": "string"
                },
                "trailing_space": {
                  "type": "string"
                },
                "collations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "policy": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "hook_groups": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "$ref": "urn:dbdatabuild:schemas:metadata#/$defs/hook"
                }
              }
            },
            "rewrites": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fidelity": {
                  "enum": [
                    "exact",
                    "native"
                  ]
                },
                "disable": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "enable": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "fidelity",
                "disable",
                "enable"
              ]
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "definition_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "native": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "access": {
                    "enum": [
                      "select",
                      "command"
                    ]
                  },
                  "connections": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "text_hash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "reads": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "access",
                  "connections",
                  "text_hash",
                  "reads"
                ]
              }
            },
            "required": [
              "name",
              "file",
              "definition_hash"
            ]
          }
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "connections": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "definition_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "name",
              "kind"
            ]
          }
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "description": "Sorted; omitted when there are none.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "properties": {
          "description": "Key to value (a string, a number or a boolean), keys sorted; omitted when there are none.",
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "required": [
        "schema",
        "tool_version",
        "matrix_version",
        "config",
        "sources",
        "models"
      ]
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "logical_type": {
          "type": "string"
