                ]
              }
            }
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "urn:dbdatabuild:schemas:metadata#/$defs/column"
          }
        },
        "expected_shape_hash": {
          "type": "object",
          "additionalProperties": {
