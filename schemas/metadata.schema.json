                    "type": "string"
                  },
                  "column": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "description": "Sorted; omitted when there are none.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "properties": {
          "description": "Key to value (a string, a number or a boolean), keys sorted; omitted when there are none.",
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "required": [
