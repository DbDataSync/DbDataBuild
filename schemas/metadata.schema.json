        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "properties": {
          "description": "Key to value (a string, a number or a boolean), keys sorted; omitted when there are none.",
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
