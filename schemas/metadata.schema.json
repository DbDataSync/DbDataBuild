            ]
          }
        }
      },
      "required": [
        "name",
        "columns",
        "unique"
      ]
    },
    "hookResolved": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "event": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "script": {
          "type": "string"
        },
        "script_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "effect": {
          "type": "string"
        },
        "risk": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "event",
        "script"
      ]
    },
    "indexAdvice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "DDB-223",
            "DDB-224"
          ]
        },
        "severity": {
          "enum": [
            "warning",
            "note"
          ]
