              },
              "type": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "constraint": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "connection",
        "operation",
        "strategy",
        "is_default"
