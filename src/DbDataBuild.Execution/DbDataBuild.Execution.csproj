<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DbDataBuild.Core\DbDataBuild.Core.csproj" />
    <ProjectReference Include="..\DbDataBuild.State\DbDataBuild.State.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- SqlClient 7.1.1 brings 9.0.18, which has advisories (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx); a direct reference takes precedence until SqlClient moves -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.6" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="System.Data.Odbc" Version="10.0.13" />
    <!-- the Flight SQL client (managed gRPC over Grpc.Net.Client; Apache.Arrow, Google.Protobuf and Grpc.Net.Client come with it): docs/research/read-origins.md, section 8b -->
    <PackageReference Include="Apache.Arrow.Flight.Sql" Version="23.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbDataBuild.Tests.Unit" />
    <InternalsVisibleTo Include="DbDataBuild.Tests.Conformance" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
